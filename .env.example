# MRK Removals Adelaide — Environment Configuration
# Copy to .env (local) or set in Vercel Project Settings. Use only credentials issued to MRK Removals Adelaide.
# Never use HF Removals or Noor Removals credentials, keys, or endpoints.

# Canonical Site Configuration
VITE_SITE_URL="https://mrkremovalsadelaide.com.au"
VITE_BOOKING_MODE="quote-only"

# Production indexing (explicit opt-in; previews stay noindex)
MRK_PRODUCTION_INDEXING=""
VITE_MRK_PRODUCTION_INDEXING=""

# Quote delivery (server-only, read by /api/quote). Never expose these to the browser.
# Primary provider: Web3Forms access key issued for the MRK inbox.
# (The Vercel production project already stores this as `web3form_key`; either name is accepted.)
WEB3FORMS_ACCESS_KEY=""
# Optional fallback provider, used only if the primary fails: Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# With neither configured, /api/quote answers `not_configured` and the form offers email/call.

# Optional Analytics (Client-visible only if explicitly issued to MRK Removals Adelaide)
VITE_MRK_GA_MEASUREMENT_ID=""

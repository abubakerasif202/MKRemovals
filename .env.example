# MRK Removals Adelaide — Environment Configuration
# Copy to .env and configure only verified MRK Removals Adelaide credentials.
# Never use HF Removals or Noor Removals credentials, keys, or endpoints.

# Canonical Site Configuration
VITE_SITE_URL="https://mrkremovalsadelaide.com.au"
VITE_BOOKING_MODE="quote-only"

# Quote Delivery Configuration (Server-only)
# Leave blank in preview mode to keep quote submissions in honest preview-recorded state.
# Set only after Mubashar Riaz approves and verifies a dedicated MRK inbox/provider.
MRK_QUOTE_PROVIDER_URL=""
MRK_QUOTE_PROVIDER_API_KEY=""
MRK_QUOTE_RECIPIENT_EMAIL=""

# Optional Analytics (Client-visible only if explicitly issued to MRK Removals Adelaide)
VITE_MRK_GA_MEASUREMENT_ID=""

# AI Studio Runtime Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

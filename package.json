{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender.ts && tsx scripts/verify-seo.ts",
    "prerender": "tsx scripts/prerender.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:redis": "tsx --test src/lib/quote-store.integration.test.ts src/lib/quote-honesty.test.ts",
    "images": "node scripts/optimize-images.mjs",
    "test": "tsx --test src/config/business.test.ts src/lib/quote-validation.test.ts src/lib/seo.test.ts src/lib/seo-indexing.test.ts src/lib/quote-delivery.test.ts src/lib/serverless-imports.test.ts src/lib/quote-store.integration.test.ts src/lib/quote-honesty.test.ts src/components/interactive/MoveScopeBuilder.test.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
